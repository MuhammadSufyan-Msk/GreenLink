# ============================================
# GreenLink+ Frontend Environment Configuration
# ============================================

# For Cloud Hosting (e.g., AWS, Vercel, Netlify), replace localhost with your public domains.

# The public URL of your Node.js backend API
VITE_API_URL=https://api.greenlink.io/api

# The public WebSocket URL for live data (wss:// for secure websockets)
VITE_WS_URL=wss://api.greenlink.io

# The public URL of your Grafana Cloud instance or EC2 Grafana server
VITE_GRAFANA_URL=https://grafana.greenlink.io
