# ============================================
# GreenLink+ Environment Configuration
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- JWT Authentication ---
JWT_SECRET=greenlink_plus_super_secret_key_change_in_production
JWT_EXPIRY=24h

# --- InfluxDB ---
# Replace localhost with your AWS/Cloud InfluxDB instance
INFLUXDB_URL=https://influxdb.greenlink.io
INFLUXDB_TOKEN=your_cloud_influxdb_token_here
INFLUXDB_ORG=greenlink
INFLUXDB_BUCKET=sensor_data

# --- MQTT Broker (Mosquitto / AWS IoT) ---
MQTT_HOST=mqtt.greenlink.io
MQTT_PORT=8883
MQTT_USERNAME=greenlink_cloud
MQTT_PASSWORD=greenlink_cloud_pass

# --- Grafana ---
GRAFANA_URL=https://grafana.greenlink.io

# --- AI Inference Service ---
AI_SERVICE_URL=https://ai.greenlink.io

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- Firebase Cloud Messaging (Push Notifications) ---
FCM_SERVER_KEY=your_fcm_server_key

# --- AWS (Production) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
