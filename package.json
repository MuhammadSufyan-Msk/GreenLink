{
  "name": "greenlink-plus",
  "version": "1.0.0",
  "description": "GreenLink+ Environmental Monitoring System — Edge IoT + AI Smart Monitoring",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "setup": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "echo 'Serving pre-built assets from Git'",
    "start": "node backend/server.js"
  },
  "keywords": ["iot", "environmental-monitoring", "ai", "esp32", "influxdb"],
  "license": "MIT"
}
